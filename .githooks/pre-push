#!/usr/bin/env bash
# Refuses to push a tag that isn't a release version: vMAJOR.MINOR.PATCH or vMAJOR.MINOR.PATCH-rc.N.
set -uo pipefail

fail=0
while read -r local_ref local_sha _ _; do
  case "$local_ref" in refs/tags/*) ;; *) continue ;; esac
  [[ $local_sha =~ ^0+$ ]] && continue
  tag=${local_ref#refs/tags/}
  if ! [[ $tag =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.[1-9][0-9]*)?$ ]]; then
    echo "pre-push: tag $tag isn't a release version like v1.2.0 or v1.2.0-rc.1"
    fail=1
  fi
done
exit $fail
