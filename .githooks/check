#!/usr/bin/env bash
# The code checks behind ./lint and the pre-commit hook. Each error says what to change.
#   .githooks/check [--fix] file...   checks the files as they are in the tree; --fix formats them first
#   .githooks/check --staged          checks what's staged, from a copy of the index
set -uo pipefail
root=$(git rev-parse --show-toplevel)
hooks="$root/.githooks"
cd "$root"

KTLINT="ktlint version 1.8.0"
RULES_VERSION=0.6.8
RULES_SHA=a25378ec616add11d2b279a87f54ccffefea87917da13773ff753386d30c22e5
MAX_LINES=500

fix=
staged=
case "${1:-}" in
  --fix) fix=1; shift ;;
  --staged) staged=1; shift ;;
esac

if [ -n "$staged" ]; then
  mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR)
  dir=$(mktemp -d)
  trap 'rm -rf "$dir"' EXIT
  git checkout-index -a --prefix="$dir/"
  [ -d worker/node_modules ] && ln -s "$root/worker/node_modules" "$dir/worker/node_modules"
else
  files=("$@")
  dir=$root
fi
pick() { printf '%s\n' "${files[@]}" | grep -E "$1"; }
fail=0

mapfile -t go < <(pick '^cli/.*\.go$')
if [ ${#go[@]} -gt 0 ]; then
  echo "cli"
  [ -n "$fix" ] && gofmt -w "${go[@]}"
  for f in $(cd "$dir" && gofmt -l "${go[@]}"); do echo "$f: not gofmt'd; run ./lint --fix $f"; fail=1; done
  (cd "$dir/cli" && go vet ./...) || fail=1
fi

mapfile -t ts < <(pick '^worker/.*\.(ts|js|json)$' | grep -v 'package-lock.json$' | sed 's|^worker/||')
if [ ${#ts[@]} -gt 0 ]; then
  echo "worker"
  (
    cd "$dir/worker" || exit 1
    [ -x node_modules/.bin/oxfmt ] || { echo "worker: run npm install first, for oxfmt and oxlint"; exit 1; }
    [ -n "$fix" ] && node_modules/.bin/oxfmt "${ts[@]}" >/dev/null
    unformatted=$(node_modules/.bin/oxfmt --list-different "${ts[@]}")
    [ -z "$unformatted" ] || { sed 's|^\(.*\)$|worker/\1: not oxfmt'\''d; run ./lint --fix worker/\1|' <<<"$unformatted"; exit 1; }
    mapfile -t code < <(printf '%s\n' "${ts[@]}" | grep -E '\.(ts|js)$')
    if [ ${#code[@]} -gt 0 ]; then node_modules/.bin/oxlint --deny-warnings "${code[@]}" || exit 1; fi
    node_modules/.bin/tsc -p .
  ) || fail=1
fi

mapfile -t kt < <(pick '^app/.*\.kts?$')
if [ ${#kt[@]} -gt 0 ]; then
  echo "app"
  command -v ktlint >/dev/null || { echo "app: ktlint not found; run nix-shell first"; exit 1; }
  [ "$(ktlint --version)" = "$KTLINT" ] ||
    { echo "app: compose-rules $RULES_VERSION needs $KTLINT, not $(ktlint --version); use the one nix-shell gives"; exit 1; }
  rules="$(git rev-parse --path-format=absolute --git-common-dir)/ktlint-compose-$RULES_VERSION-all.jar"
  if ! sha256sum -c --status <<<"$RULES_SHA  $rules" 2>/dev/null; then
    curl -fsSL -o "$rules" "https://github.com/mrmans0n/compose-rules/releases/download/v$RULES_VERSION/ktlint-compose-$RULES_VERSION-all.jar" &&
      sha256sum -c --status <<<"$RULES_SHA  $rules" || { rm -f "$rules"; echo "app: couldn't fetch compose-rules"; exit 1; }
  fi
  paths=("${kt[@]/#/$dir/}")
  [ -n "$fix" ] && ktlint -F --log-level=error -R "$rules" "${paths[@]}" >/dev/null 2>&1
  out=$(ktlint --log-level=error -R "$rules" "${paths[@]}" 2>&1) ||
    { sed "s|$dir/||" <<<"$out" | grep -v '^$'; echo "app: ./lint --fix fixes the formatting; the rest needs a hand"; fail=1; }
  for f in "${kt[@]}"; do
    case "$f" in */src/test/*) ;; *) "$hooks/placeholders" "$f" <"$dir/$f" || fail=1 ;; esac
    case "$f" in app/core/*) "$hooks/core-free" "$f" <"$dir/$f" || fail=1 ;; esac
    case "$f" in */src/test/* | */src/*Test/*) ;; app/shared/*) "$hooks/grows" "$f" <"$dir/$f" || fail=1 ;; esac
  done
fi

while read -r f; do
  n=$(wc -l <"$dir/$f")
  [ "$n" -gt $MAX_LINES ] && { echo "$f: $n lines, over $MAX_LINES; split it"; fail=1; }
done < <(pick '\.(go|ts|js|kt|kts)$')

for f in "${files[@]}"; do
  [ "$(head -c2 "$dir/$f" 2>/dev/null)" = '#!' ] || continue
  mode=$(git ls-files -s -- "$f" | cut -d' ' -f1)
  [ -z "$mode" ] || [ "$mode" = 100755 ] ||
    { echo "$f: a script without its executable bit in git; run: git update-index --chmod=+x $f"; fail=1; }
done

exit $fail
