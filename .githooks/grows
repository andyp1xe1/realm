#!/usr/bin/env bash
# Checks one app/shared file (stdin, named by $1) for layouts that jump: growing as data arrives, and buttons
# whose hover background touches the label. Intended growth says why on the line: // grows: <reason>
set -uo pipefail
fail=0
n=0
recent=()
while IFS= read -r text || [ -n "$text" ]; do
  n=$((n + 1))
  recent=("${recent[@]: -3}" "$text")
  [[ $text =~ ^[[:space:]]*(import|//|\*|/\*) ]] && continue
  why=
  if [[ $text =~ (expandVertically|expandHorizontally|expandIn|animateContentSize)\( ]]; then
    why="${BASH_REMATCH[1]}: data arriving must not grow the layout: show it with Loading(…) from ui/Loading.kt"
  elif [[ $text =~ contentPadding[[:space:]]*=[[:space:]]*PaddingValues\([[:space:]]*0 ]] &&
    printf '%s\n' "${recent[@]}" | grep -qE '\b(Text|Outlined)?Button\('; then
    why="a button with no padding has its hover background touching the label: use InlineButton from ui/Buttons.kt"
  fi
  [ -z "$why" ] && continue
  if [[ ! $text =~ //\ grows:\ .+ ]]; then
    echo "$1:$n: $why"
  else
    continue
  fi
  fail=1
done
exit $fail
