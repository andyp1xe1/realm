#!/usr/bin/env bash
# Checks the tree as the pre-commit hook checks what's staged: all of it, or only the given paths.
#   ./lint [--fix] [path...]   e.g. ./lint app, ./lint --fix worker/src, ./lint cli/main.go
set -uo pipefail
root=$(cd "$(dirname "$0")" && pwd)
command -v ktlint >/dev/null || exec nix-shell "$root/shell.nix" --run "$(printf '%q ' "$0" "$@")"
fix=()
[ "${1:-}" = --fix ] && { fix=(--fix); shift; }
paths=()
for p in "$@"; do
  [ -e "$p" ] || { echo "no such path: $p"; exit 2; }
  paths+=("$(realpath --relative-to="$root" "$p")")
done
cd "$root"
mapfile -t files < <(git ls-files -co --exclude-standard -- "${paths[@]}")
printf '%s\n' "${files[@]}" | grep -qE '\.(go|ts|js|json|kt|kts)$' || { echo "nothing to lint there"; exit 2; }
.githooks/check "${fix[@]}" "${files[@]}" && echo "all clean"
